# Vet AI Tutor settings. Copy to .env and uncomment what you change.
# Environment variables override this file. Generated by:
#   python -m vet_ai_tutor.config --env-example > .env.example

# Vector store: chroma (recommended) or faiss (legacy fallback)
# VET_VECTOR_BACKEND=chroma

# Directory of the active knowledge index
# VET_VECTOR_PATH=data/chroma_db

# Embedding provider: ollama (no PyTorch) or huggingface
# VET_EMBEDDING_BACKEND=ollama

# Embedding model name; changing it requires an index rebuild
# VET_EMBEDDING_MODEL=nomic-embed-text

# Apply the task prefixes the embedding model expects (rebuild after changing)
# VET_EMBEDDING_PREFIXES=auto

# Ollama model that writes answers
# VET_LLM_MODEL=qwen3:1.7b

# How long Ollama keeps the model in memory
# VET_OLLAMA_KEEP_ALIVE=30m

# Context window in tokens (prompt + passages + answer)
# VET_LLM_NUM_CTX=2048

# Maximum answer length in tokens
# VET_LLM_NUM_PREDICT=256

# Sampling temperature; low keeps answers close to sources
# VET_LLM_TEMPERATURE=0.3

# Seconds to wait for Ollama before giving up
# VET_LLM_TIMEOUT=300

# Qwen3 thinking mode; very slow on CPU
# VET_LLM_REASONING=0

# Passages sent to the model per question
# VET_RETRIEVER_K=5

# Candidates per search (vector, BM25) before fusion
# VET_RETRIEVAL_CANDIDATES=20

# Reciprocal Rank Fusion constant
# VET_RRF_K=60

# Cross-encoder re-ranking (needs sentence-transformers and a cached model)
# VET_USE_RERANKER=0

# Cached answers kept in memory
# VET_CACHE_MAX=128

# Seconds a cached answer stays valid
# VET_CACHE_TTL=3600

# Source documents for full rebuilds
# VET_RAW_DIR=data/raw_notes

# Characters per chunk; rebuild after changing
# VET_CHUNK_SIZE=600

# Characters shared between neighbouring chunks
# VET_CHUNK_OVERLAP=100

# Harvested and staged JSON records
# VET_STAGING_DIR=data/staging

# Approved web domains by tier
# VET_WHITELIST_PATH=data/whitelist.json

# Reviewed provenance for raw notes
# VET_SOURCE_CATALOG_PATH=data/source_metadata.json

# OCR text, converted legacy files and embedding cache
# VET_INGEST_CACHE_DIR=data/cache

# Minimum Tesseract confidence for an OCR'd page
# VET_OCR_MIN_CONFIDENCE=70.0

# Never let the embedding fallback reach the network
# VET_OFFLINE_ONLY=1

# Where created patches are written
# VET_PATCHES_DIR=data/patches

# Index backups made before replacing it
# VET_BACKUPS_DIR=data/backups

# Enables developer routes (send as X-Admin-Token); keep secret
# VET_ADMIN_TOKEN=

# Ed25519 public key that patches must verify against
# VET_PATCH_PUBLIC_KEY_PATH=data/patch_signing_public.pem

# Ed25519 private key used to sign patches
# VET_PATCH_SIGNING_KEY=

# Accept unsigned patches when no key is installed (dev only)
# VET_ALLOW_UNSIGNED_PATCHES=0

# Largest uncompressed patch accepted
# VET_MAX_PATCH_BYTES=21474836480

# Largest patch upload through the API
# VET_MAX_PATCH_UPLOAD_BYTES=8589934592

# Messages remembered per conversation
# VET_MAX_HISTORY=10

# Conversations kept in memory
# VET_MAX_SESSIONS=200

# Seconds before an idle conversation is forgotten
# VET_SESSION_TTL=7200

# Bind address; 0.0.0.0 serves a classroom LAN
# VET_API_HOST=127.0.0.1

# HTTP port
# VET_API_PORT=8000

# Auto-reload on code changes (development)
# VET_API_RELOAD=0

# Comma-separated allowed origins (default: localhost on the API port)
# VET_CORS_ORIGINS=

# Questions per client per minute (0 disables)
# VET_RATE_LIMIT_PER_MINUTE=20

# Longest question accepted
# VET_MAX_QUESTION_CHARS=1000

# Log verbosity
# VET_LOG_LEVEL=INFO

# text for people, json for tools
# VET_LOG_FORMAT=text

